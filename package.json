{
  "name": "dsh-netease-music",
  "version": "0.4.7",
  "description": "DSH 插件：在 dsh 里看/控网易云正在播放的音乐，管歌单——带独立控制面板、实时进度条与歌词",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7",
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "netease",
    "music",
    "网易云音乐"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdfedsfsdf/dsh-netease-music.git"
  },
  "homepage": "https://github.com/sdfedsfsdf/dsh-netease-music#readme",
  "bugs": {
    "url": "https://github.com/sdfedsfsdf/dsh-netease-music/issues"
  },
  "license": "MIT"
}
